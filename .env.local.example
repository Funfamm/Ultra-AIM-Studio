# ── Database (Neon Postgres) ───────────────────────────────────
# Get both connection strings from: https://neon.tech → your project → Connection Details
# DATABASE_URL  — pooled connection (used by app at runtime via Neon connection pooler)
# DIRECT_URL    — direct/non-pooled connection (used by Prisma for migrations + serverless)
# Both URLs point to the same Neon project. They differ only in the hostname prefix.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js v5 ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-secret"

# AUTH_URL: used by Auth.js to construct OAuth callback URLs.
# Must match the Vercel deployment URL exactly (no trailing slash).
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
AUTH_URL="http://localhost:3000"

# ── App URL ───────────────────────────────────────────────────
# Used by email templates, unsubscribe links, share links.
# Must be set to the main production domain in Vercel env vars.
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth ──────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs to add:
#   Local:      http://localhost:3000/api/auth/callback/google
#   Production: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ── Microsoft Graph (transactional email) ─────────────────────
# Used for: welcome, password reset, security alerts, account alerts
# Azure Portal → App registrations → your app → Certificates & secrets
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_CLIENT_SECRET="your-azure-client-secret"
AZURE_TENANT_ID="your-azure-tenant-id"
GRAPH_EMAIL_SENDER="noreply@yourdomain.com"

# ── Azure Communication Services (bulk email) ─────────────────
# Used for: campaigns, outreach, new release/episode, notify-me follow-ups
# Azure Portal → Communication Services → your resource → Keys
ACS_CONNECTION_STRING="endpoint=https://your-acs.communication.azure.com/;accesskey=your-key"
ACS_SENDER_ADDRESS="DoNotReply@your-acs-domain.azurecomm.net"

# ── SMTP (optional fallback) ──────────────────────────────────
# Only used if bulk provider is set to SMTP in admin settings
SMTP_HOST="smtp.yourmailprovider.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@yourdomain.com"

# ── Seed script (dev only) ────────────────────────────────────
# Used by: npm run db:seed — creates the first admin user
# SEED_ADMIN_PASSWORD is required — seed will exit if not set
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-me-before-running"

# ── Cron job authorization ────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron requests.
# Route handlers verify it before processing. Set in Vercel env vars for production.
# If not set, cron routes are publicly invocable — set this before production launch.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-generated-secret"

# ── Migration scripts (dev only) ──────────────────────────────
# Used by: scripts/inspect-old-db*.mjs, scripts/migrate-users-*.mjs
# Set this to the source/old database you are migrating FROM.
# Never commit this value.
SOURCE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
