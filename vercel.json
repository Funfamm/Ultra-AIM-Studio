{
  "buildCommand": "npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning-report",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/scheduled-outreach",
      "schedule": "*/5 * * * *"
    }
  ]
}
